<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="2columns-left"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <!-- The enrollment banner only links back to this page -->
        <referenceBlock name="passkey.enrollment.prompt" remove="true"/>
        <referenceContainer name="content">
            <block class="MageOS\PasskeyAuth\Block\Account\Passkeys"
                   name="customer.account.passkeys"
                   template="MageOS_PasskeyAuth::account/passkeys.phtml"
                   cacheable="false"/>
        </referenceContainer>
    </body>
</page>
